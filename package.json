{
  "name": "tracetoon",
  "version": "1.0.0-rc.17",
  "description": "Write pull request descriptions from the AI agent session logs already on your machine, plus a 4-panel comic.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "tracetoon": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "format": "bun x prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "bundle": "bun run scripts/bundle.ts",
    "build": "bun build --compile --minify ./src/cli.ts --outfile dist/tracetoon"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "commander": "^14.0.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "@expo-google-fonts/comic-neue": "^0.4.1"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}

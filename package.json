{
  "name": "tracetoon",
  "version": "1.0.0-rc.22",
  "description": "Write pull request descriptions from the AI agent session logs already on your machine, plus a one-off comic.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "tracetoon": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun run scripts/test-source.ts",
    "test:bundled": "bun run scripts/test-packaged.ts",
    "test:compiled": "bun run scripts/test-packaged.ts --compiled",
    "typecheck": "bun x tsc --noEmit",
    "format": "bun x prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "bundle": "bun run scripts/bundle.ts",
    "build": "bun run scripts/build.ts",
    "build:check": "bun run scripts/build-info.ts --check"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "commander": "^14.0.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "@expo-google-fonts/comic-neue": "^0.4.1"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
